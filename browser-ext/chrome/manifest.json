{
  "manifest_version": 3,
  "name": "Snap2AI",
  "version": "1.0.0",
  "description": "右クリックから Snap2AI で画面を切り取り、AI のチャット欄に貼り付けます（送信は押しません）",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "homepage_url": "https://github.com/ryofssmax-a11y/snap2ai"
}