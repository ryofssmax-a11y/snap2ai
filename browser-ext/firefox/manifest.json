{
  "manifest_version": 2,
  "name": "Snap2AI",
  "version": "1.0.0",
  "description": "右クリックから Snap2AI で画面を切り取り、AI のチャット欄に貼り付けます（送信は押しません）",
  "browser_specific_settings": {
    "gecko": {
      "id": "snap2ai@ryo.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "homepage_url": "https://github.com/ryofssmax-a11y/snap2ai"
}